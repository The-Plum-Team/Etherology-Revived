  "mixins": [
    {
      "config": "etherology-original-baseline-harness.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": "=${fabric_loader_version}",
    "fabric-api": "=${fabric_api_version}",
    "minecraft": "=${minecraft_version}",
    "java": ">=${java_version}",
    "etherology": "=${etherology_version}"
  }
