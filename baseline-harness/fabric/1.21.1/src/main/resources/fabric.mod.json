{
  "schemaVersion": 1,
  "id": "etherology_original_baseline_harness",
  "version": "${version}",
  "name": "Etherology Original Baseline Harness",
  "description": "Client-only evidence harness for the published Etherology 0.1.7 reference.",
  "license": "LGPL-2.1-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.theplumteam.etherology.baseline.fabric.OriginalPhaseZeroHarness"
    ]
