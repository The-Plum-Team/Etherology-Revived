{
  "schemaVersion": 1,
  "id": "etherology",
  "version": "${version}",
  "name": "Etherology Revived",
  "description": "Science is indistinguishable from magic!",
  "authors": [
    "Faradey",
    "Feytox"
  ],
  "contact": {
    "homepage": "https://github.com/The-Plum-Team/Etherology-Revived",
    "sources": "https://github.com/The-Plum-Team/Etherology-Revived",
    "issues": "https://github.com/The-Plum-Team/Etherology-Revived/issues"
  },
  "license": "LGPL-2.1-only",
  "icon": "assets/etherology/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "ru.feytox.etherology.client.datagen.DataGeneration"
    ],
    "client": [
      "ru.feytox.etherology.client.EtherologyClient"
    ],
    "main": [
      "ru.feytox.etherology.EtherologyFabric"
    ],
    "cardinal-components": [
      "ru.feytox.etherology.registry.misc.FabricEtherologyComponents"
    ],
    "mm:early_risers": [
      "ru.feytox.etherology.mixin.EarlyRisers"
    ],
    "mixinsquared": [
      "ru.feytox.etherology.mixin.EMixinCanceller"
    ],
    "rei_client": [
      "ru.feytox.etherology.client.compat.rei.EtherREIPlugin"
    ],
    "emi": [
      "ru.feytox.etherology.client.compat.emi.EtherEMIPlugin"
    ]
  },
  "mixins": [
    "etherology.mixins.json",
    {
      "config": "etherology.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "=${minecraft_version}",
    "java": ">=${java_version}",
    "architectury": ">=${architectury_api_version}",
    "biolith": ">=${biolith_version}",
    "fabricshieldlib": ">=${fabric_shield_lib_version}",
    "owo": ">=${owo_lib_version}",
    "trinkets": ">=${trinkets_version}",
    "geckolib": ">=${geckolib_version}",
    "cardinal-components-base": ">=${cardinal_components_version}",
    "cardinal-components-entity": ">=${cardinal_components_version}",
    "cardinal-components-chunk": ">=${cardinal_components_version}",
    "mm": ">=${fabric_asm_metadata_version}"
  },
  "suggests": {
    "modmenu": ">=${mod_menu_version}",
    "roughlyenoughitems": ">=${rei_version}",
    "emi": ">=${emi_version}",
    "cloth-config": ">=${cloth_config_version}"
  },
  "custom": {
    "cardinal-components": [
      "etherology:corruption",
      "etherology:ether",
      "etherology:teldecore",
      "etherology:visited"
    ]
  },
  "accessWidener": "etherology.accesswidener"
}
